{
  "name": "oiia-cat",
  "version": "0.1.0",
  "description": "OIIA Maxwell cat desktop overlay",
  "main": "src/main.js",
  "scripts": {
    "start": "node start.js",
    "test": "jest",
    "rebuild": "electron-rebuild -f -w uiohook-napi",
    "dist": "electron-builder"
  },
  "dependencies": {
    "electron-store": "^8.1.0",
    "uiohook-napi": "^1.5.4"
  },
  "devDependencies": {
    "cross-env": "^10.1.0",
    "electron": "^28.3.3",
    "electron-builder": "^24.9.1",
    "electron-rebuild": "^3.2.9",
    "jest": "^29.7.0"
  },
  "build": {
    "appId": "com.oiia.cat",
    "productName": "SpinCay by Key",
    "files": [
      "src/**/*",
      "assets/**/*",
      "node_modules/**/*",
      "!assets/yt-dlp.exe"
    ],
    "asarUnpack": [
      "node_modules/uiohook-napi/**/*"
    ],
    "win": {
      "target": "nsis",
      "icon": "assets/cat.ico"
    },
    "nsis": {
      "oneClick": true,
      "perMachine": false,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  }
}
